# .gitignore — files Git should never track.
#
# Two kinds of things belong here:
#   1. Things that can be REGENERATED (node_modules, dist) — committing them
#      would bloat the repo for no reason.
#   2. Things that are SECRET or PERSONAL (.env, keys, tokens) — committing one
#      of these publishes it to everyone, forever, even if you delete it later.
#
# Patterns match at any depth, so `node_modules` here also covers
# `frontend/node_modules`.

# ---------------------------------------------------------------------------
# Dependencies — reinstall with `npm install`
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output — regenerate with `npm run build`
# ---------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secrets and credentials — NEVER commit these
#
# If you ever commit a secret by accident, deleting it in a later commit is not
# enough: it stays in the repository's history. Treat it as leaked and replace
# the key at its source.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# npm auth tokens live in here — a very common accidental leak
.npmrc
.yarnrc
.yarnrc.yml

# Certificates and private keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# Credential files by common name
secrets.json
credentials.json
service-account*.json
auth.json
*.secret
*_rsa
*_rsa.pub
.ssh/
.aws/
.gnupg/

# Deploy platform folders — these often cache project tokens
.vercel/
.netlify/
.wrangler/
.firebase/
.serverless/

# Anything you deliberately keep local
*.local

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.json

# ---------------------------------------------------------------------------
# Caches and temporary files
# ---------------------------------------------------------------------------
.cache/
.temp/
.tmp/
.vite/
.eslintcache
.stylelintcache
coverage/
.nyc_output/
*.pid
*.seed

# ---------------------------------------------------------------------------
# Editors and IDEs
#
# .vscode is ignored except for extensions.json, which is a useful shared
# recommendation rather than a personal setting.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# ---------------------------------------------------------------------------
# Operating system clutter
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini



# ---------------------------------------------------------------------------
# Python's runtime, copied out of node_modules by `npm run sync:pyodide`.
# 14 MB of generated files — regenerated by the build, so never committed.
# ---------------------------------------------------------------------------
public/pyodide/
