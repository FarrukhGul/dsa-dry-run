# Security headers, applied to every page when deployed.
#
# This file format is understood by Cloudflare Pages and Netlify. If you deploy
# somewhere else (Vercel, nginx, Apache), copy these same headers into that
# host's config — the header names and values are identical everywhere.
#
# These have no effect while running `npm run dev` locally. They apply to the
# built site only.

/*
  # Stop other sites from putting our pages inside an invisible frame and
  # tricking people into clicking things (clickjacking).
  X-Frame-Options: DENY

  # Don't let the browser guess a file's type. If we say it's an image, it is
  # treated as an image and never executed as a script.
  X-Content-Type-Options: nosniff

  # When someone clicks a link out of our site, send only our domain as the
  # referrer, not the full URL. Shared dry-run links can contain code.
  Referrer-Policy: strict-origin-when-cross-origin

  # We never need a camera, microphone or location. Turn them off entirely so
  # nothing can ask.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Content Security Policy — the important one. It lists the only places the
  # browser is allowed to load things from, so injected code has nowhere to
  # phone home to.
  #
  #   default-src 'self'      by default, only load from our own domain
  #   script-src  'self'      no inline scripts, no eval, on the page itself
  #   style-src   + inline    React and CodeMirror set inline styles
  #   font/style  + Google    the Assistant and JetBrains Mono webfonts
  #   worker-src  'self'      the dry run engine's background thread
  #   connect-src 'self'      no sending data to anyone else
  #   object-src  'none'      no Flash-era plugins
  #   frame-ancestors 'none'  same idea as X-Frame-Options, modern version
  #   img-src     + blob:   the whiteboard draws and exports images this way
  Content-Security-Policy: default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'

# ---------------------------------------------------------------------------
# The dry run engine's background thread — the one file that runs your code.
#
# THE PROBLEM
# To dry run your code, the engine has to turn text into something runnable.
# That is `new Function`, which the policy above deliberately forbids. Allowing
# it site-wide would weaken every page to make one file work.
#
# THE ANSWER
# A worker can carry its own policy, so this one gets a rule of its own. It is
# not a relaxed version of the policy above — it is a different trade:
#
#   script-src 'unsafe-eval'   it MAY compile your code
#   connect-src 'none'         it may NOT reach the network. At all.
#   default-src 'none'         and it may not load anything else either
#
# So the single file permitted to run a stranger's code is also the single file
# with no way to send anything anywhere. That is a better bargain than it
# looks: exfiltration is the thing worth preventing, and this removes the
# route entirely.
#
# This is why vite.config.js pins the worker to a fixed filename — a rule
# cannot target a name that changes on every build.
#
# ⚠ VERIFY THIS AFTER YOUR FIRST DEPLOY.
# Per-path headers behave slightly differently on each host. Open the deployed
# site, run a dry run, and check the browser console. If you see a Content
# Security Policy error mentioning 'unsafe-eval', this rule is not being
# applied and the engine will not work in production.
# ---------------------------------------------------------------------------

/workers/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'
  X-Content-Type-Options: nosniff
